{
  "name": "mutt-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "check:dev": "node scripts/check-dev.mjs",
    "assets:export": "node scripts/export-artworks.mjs",
    "build": "vite build",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:mocks": "tsc -p tsconfig.mocks.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep \"regressao visual\"",
    "test:e2e:report": "playwright show-report reports/e2e",
    "lint": "eslint src tests *.config.ts",
    "format": "prettier --write src tests scripts *.config.ts eslint.config.js",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "mocks:init": "msw init public --save"
  },
  "dependencies": {
    "@fontsource/space-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "engine.io-client": "^6.6.7",
    "lucide-react": "^0.468.0",
    "msw": "2.10.2",
    "nitro": "^3.0.260903-beta",
    "react": "19.2",
    "react-dom": "19.2",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/binding-wasm32-wasi": "1.2.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "chrome-launcher": "1.2.2",
    "eslint": "^10.12.0",
    "lighthouse": "^13.5.0",
    "node": "^22.23.3",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
